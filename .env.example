# Application traffic: use the pooled connection string from Neon.
# Keep real values in ignored .env.local or your host's secret settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require

# Migrations: use the direct connection to the same database when available.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required behind an HTTPS reverse proxy. Use the exact public origin.
# Leave unset when developing at http://127.0.0.1:3000.
# DONEKITE_ORIGIN=https://donekite.example.com
